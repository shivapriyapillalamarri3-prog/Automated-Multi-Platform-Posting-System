# Copy to .env and fill in. NEVER commit .env. Every platform is optional:
# a platform without credentials simply returns a "failed" result.

# Optional: comma-separated subset to post to (default: all five)
# POSTING_PLATFORMS=bluesky,mastodon,discord,matrix,stoat
# POSTING_TIMEOUT_SECONDS=30

# Bluesky - Settings > Privacy and security > App passwords
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# BLUESKY_PDS_URL=https://bsky.social

# Mastodon - Preferences > Development > New application (scope: write:statuses)
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=your-access-token

# Discord - Channel settings > Integrations > Webhooks (the URL itself is a secret)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>

# Matrix - access token for a user that is a member of the room
MATRIX_HOMESERVER_URL=https://matrix.org
MATRIX_ROOM_ID=!roomid:matrix.org
MATRIX_ACCESS_TOKEN=your-access-token

# Stoat - bot token; the bot must be added to the server/channel
STOAT_BOT_TOKEN=your-bot-token
STOAT_SERVER_ID=your-server-id
STOAT_CHANNEL_ID=your-channel-id
